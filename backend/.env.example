PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/provision_store
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# SMTP settings used to send account-verification codes.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Resend SMTP, etc).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Provision Store <no-reply@provisionstore.local>"
